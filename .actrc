# Both act runner labels use the host architecture; this does not test cross-arch builds.
-P ubuntu-latest=catthehacker/ubuntu:act-latest
-P ubuntu-24.04-arm=catthehacker/ubuntu:act-latest

# Run tests without publishing: act pull_request -j build-php-image --container-options '-v /tmp:/tmp'
# The bind mount lets dgoss resolve its paths through the host Docker daemon.
